# Local Workers secrets only. Never commit .dev.vars with real values.
DATABASE_URL=
# Clerk secret key (sk_test_… / sk_live_…): server only, Cloudflare Secret in production.
CLERK_SECRET_KEY=
# Production origin: https://carreras-viajeras.mentec.dev
# Development only: http://localhost:3000 or http://localhost:8787
APP_ORIGIN=
# Optional integrations (crm-leads-capture). Leave blank if unused.
# Bearer token for the private n8n API: Cloudflare Secret and n8n credential, at least 32 random characters.
N8N_API_TOKEN=
# Customer email via n8n SMTP. SMTP credentials stay in n8n.
CRM_EMAIL_AUTOMATION_ENABLED=false
CRM_EMAIL_FROM=
CRM_EMAIL_AUTOMATION_START_AT=
# Optional team inbox that receives an alert for every new lead; leave blank to skip the alert.
CRM_TEAM_ALERT_EMAIL=
# Sales cadence emails (crm-sales-cadence). Off by default; turn on only once the unsubscribe link (Phase 2) is deployed.
CRM_SALES_CADENCE_ENABLED=false
# Turnstile Secret Key (Cloudflare Secret). Real key only: npm run preview runs in production mode and rejects test keys.
TURNSTILE_SECRET_KEY=
