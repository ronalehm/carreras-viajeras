# Runtime only. Fill locally; never commit real credentials.
# Neon app role with minimum permissions; PostgreSQL URL must use sslmode=require.
DATABASE_URL=
# Clerk publishable key (pk_test_… / pk_live_…): public, embedded at build time
# (also a Workers Builds build variable and a wrangler.jsonc var).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Clerk secret key (sk_test_… / sk_live_…): server only, Cloudflare Secret. Never NEXT_PUBLIC_*.
CLERK_SECRET_KEY=
# Production origin: https://carreras-viajeras.mentec.dev
# Development only: http://localhost:3000, http://localhost:3001 or http://localhost:8787
APP_ORIGIN=
# Reserved for explicitly authorized migrations; never upload to Workers/n8n.
DATABASE_MIGRATION_URL=
# Optional integrations (crm-leads-capture). Leave blank if unused; the CRM works without them.
# Bearer token for the private n8n API: Cloudflare Secret and n8n credential, at least 32 random characters.
N8N_API_TOKEN=
# Customer email via n8n SMTP. Off by default; choose the cutoff after migration/deployment.
CRM_EMAIL_AUTOMATION_ENABLED=false
CRM_EMAIL_FROM=
CRM_EMAIL_AUTOMATION_START_AT=
# Optional team inbox that receives an alert for every new lead; leave blank to skip the alert.
CRM_TEAM_ALERT_EMAIL=
# Sales cadence emails (crm-sales-cadence). Off by default; turn on only once the unsubscribe link (Phase 2) is deployed.
CRM_SALES_CADENCE_ENABLED=false
# Turnstile Secret Key (Cloudflare Secret). Test keys for npm run dev are in the README.
TURNSTILE_SECRET_KEY=
# Turnstile Site Key: public, embedded at build time (also a Workers Builds build variable).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Microsoft Clarity project id (analytics-clarity): public and optional. Empty = Clarity off (no banner,
# no script). Production example: z63dn24o7t. Embedded at BUILD time: set it as a Workers Builds/CI build
# variable; a wrangler.jsonc var alone does not change an already built bundle. It only loads in a
# production build on carreras-viajeras.mentec.dev, and only after the visitor accepts analytics.
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Stripe Checkout for bookings (README: "Stripe Checkout (modo demo TEST)"). Off by default.
# The published-site demo uses Stripe TEST only: never an sk_live_/rk_live_ key there.
# Secret key, server only (Cloudflare Secret): sk_test_/rk_test_ outside production. In production,
# sk_live_/rk_live_ for live mode, or sk_test_/rk_test_ only with STRIPE_DEMO_MODE=true. The key prefix
# sets the mode; a key the environment does not admit keeps Checkout and the webhook off.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint <APP_ORIGIN>/api/webhooks/stripe (Cloudflare Secret): whsec_...
# Locally, the secret printed by `stripe listen`; in the demo, the one of the test-mode endpoint of the domain.
STRIPE_WEBHOOK_SECRET=
# "true" turns Checkout on. Production also requires a live key (or demo mode with a test key), the
# webhook secret, the production APP_ORIGIN and, for live, no draft-contract bypass; anything missing keeps
# it off. Plain var: in production it lives in wrangler.jsonc vars. Return URLs use APP_ORIGIN
# (STRIPE_CHECKOUT_ORIGIN is no longer used).
STRIPE_CHECKOUT_ENABLED=false
# Test or demo mode only: lets Checkout use draft contracts whose text starts with the test-document
# prefix. With a live key it keeps Checkout off.
STRIPE_CHECKOUT_SANDBOX_DRAFT_CONTRACTS=false
# Production only. "true" runs the demo: Stripe TEST in production, with an sk_test_/rk_test_ key,
# the webhook secret of a test-mode endpoint and the production APP_ORIGIN. A live key under this
# flag keeps Checkout and the webhook off. Ignored outside production. Plain var in wrangler.jsonc vars,
# "false" by default.
STRIPE_DEMO_MODE=false
