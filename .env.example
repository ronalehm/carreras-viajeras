# Runtime only. Fill locally; never commit real credentials.
# Neon app role with minimum permissions; PostgreSQL URL must use sslmode=require.
DATABASE_URL=
# Clerk publishable key (pk_test_… / pk_live_…): public, embedded at build time
# (also a Workers Builds build variable and a wrangler.jsonc var).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Clerk secret key (sk_test_… / sk_live_…): server only, Cloudflare Secret. Never NEXT_PUBLIC_*.
CLERK_SECRET_KEY=
# Production origin: https://carreras-viajeras.mentec.dev
# Development only: http://localhost:3000 or http://localhost:8787
APP_ORIGIN=
# Reserved for explicitly authorized migrations; never upload to Workers/n8n.
DATABASE_MIGRATION_URL=
# Optional integrations (crm-leads-capture). Leave blank if unused; the CRM works without them.
# Bearer token for the private n8n API: Cloudflare Secret and n8n credential, at least 32 random characters.
N8N_API_TOKEN=
# Customer email via n8n SMTP. Off by default; choose the cutoff after migration/deployment.
CRM_EMAIL_AUTOMATION_ENABLED=false
CRM_EMAIL_FROM=
CRM_EMAIL_AUTOMATION_START_AT=
# Optional team inbox that receives an alert for every new lead; leave blank to skip the alert.
CRM_TEAM_ALERT_EMAIL=
# Turnstile Secret Key (Cloudflare Secret). Test keys for npm run dev are in the README.
TURNSTILE_SECRET_KEY=
# Turnstile Site Key: public, embedded at build time (also a Workers Builds build variable).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
