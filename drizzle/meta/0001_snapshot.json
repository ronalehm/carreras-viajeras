      "indexes": {
        "trips_slug_uq": {
          "name": "trips_slug_uq",
          "columns": [
            {
              "expression": "slug",
              "isExpression": false,
              "asc": true,
              "nulls": "last"
            }
          ],
          "isUnique": true,
          "concurrently": false,
          "method": "btree",
          "with": {}
        }
      },
      "foreignKeys": {},
      "compositePrimaryKeys": {},
      "uniqueConstraints": {},
      "policies": {},
      "checkConstraints": {
        "trips_slug_format_chk": {
          "name": "trips_slug_format_chk",
          "value": "\"trips\".\"slug\" ~ '^[a-z0-9]+(-[a-z0-9]+)*$' AND char_length(\"trips\".\"slug\") BETWEEN 3 AND 80"
        },
        "trips_travel_dates_chk": {
          "name": "trips_travel_dates_chk",
          "value": "(\"trips\".\"start_date\" IS NULL) = (\"trips\".\"end_date\" IS NULL) AND (\"trips\".\"start_date\" IS NULL OR (\"trips\".\"start_date\" <= \"trips\".\"race_date\" AND \"trips\".\"race_date\" <= \"trips\".\"end_date\"))"
        },
        "trips_distances_chk": {
          "name": "trips_distances_chk",
          "value": "cardinality(\"trips\".\"distances\") BETWEEN 1 AND 10"
        },
        "trips_includes_chk": {
          "name": "trips_includes_chk",
          "value": "cardinality(\"trips\".\"includes\") <= 20"
        },
        "trips_price_usd_chk": {
          "name": "trips_price_usd_chk",
          "value": "\"trips\".\"price_usd\" IS NULL OR \"trips\".\"price_usd\" >= 0"
        },
        "trips_capacity_chk": {
          "name": "trips_capacity_chk",
          "value": "\"trips\".\"capacity\" IS NULL OR \"trips\".\"capacity\" > 0"
        },
        "trips_image_url_chk": {
          "name": "trips_image_url_chk",
          "value": "\"trips\".\"image_url\" IS NULL OR \"trips\".\"image_url\" LIKE 'https://%'"
        }
      },
      "isRLSEnabled": false
    }
