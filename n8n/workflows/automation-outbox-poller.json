    {
      "parameters": {
        "jsCode": "// Deduplicación entre ejecuciones por eventId: la entrega es al menos una vez.\n// sentEventIds = { [eventId]: fecha ISO del envío }; lo escribe \"Registrar envío\".\n// La static data solo se guarda en ejecuciones de producción (workflow activo).\nconst sentEventIds = $getWorkflowStaticData('global').sentEventIds ?? {};\n\nreturn $input.all().map((item, index) => ({\n  json: { ...item.json, alreadySent: Object.prototype.hasOwnProperty.call(sentEventIds, item.json.eventId) },\n  pairedItem: { item: index },\n}));"
      },
      "id": "24a1e15c-2180-4d04-972d-117a090ffef1",
      "name": "Deduplicar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        100
      ]
