    {
      "parameters": {
        "jsCode": "// Registra el eventId de cada correo enviado (para no reenviarlo si el ack falla)\n// y poda las entradas de más de 30 días. Devuelve solo lo que necesita el ack.\nconst staticData = $getWorkflowStaticData('global');\nconst sentEventIds = staticData.sentEventIds ?? {};\nconst now = new Date();\nconst cutoff = now.getTime() - 30 * 24 * 60 * 60 * 1000;\n\nfor (const [eventId, sentAt] of Object.entries(sentEventIds)) {\n  const time = Date.parse(sentAt);\n  if (Number.isNaN(time) || time < cutoff) delete sentEventIds[eventId];\n}\n\nconst items = $input.all().map((_, index) => {\n  const { eventId, leaseToken } = $('Preparar correo').itemMatching(index).json;\n  sentEventIds[eventId] = now.toISOString();\n  return { json: { eventId, leaseToken }, pairedItem: { item: index } };\n});\n\nstaticData.sentEventIds = sentEventIds;\nreturn items;"
      },
