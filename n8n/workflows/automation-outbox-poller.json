              "name": "leaseToken",
              "value": "={{ $json.leaseToken }}",
              "type": "string"
            },
            {
              "id": "c9a0fd2e-2c25-4fd4-bf56-e44cb029f928",
              "name": "subject",
              "value": "={{ $json.payload.tripSlug ? 'Nuevo lead para ' + $json.payload.tripSlug : 'Nuevo lead sin viaje' }}",
              "type": "string"
            },
            {
              "id": "d81c9f8b-6145-480a-80d0-e6a2530b2db7",
              "name": "body",
              "value": "=Hay un lead nuevo en Carreras Viajeras.\n\nViaje de interés: {{ $json.payload.tripSlug ?? 'sin viaje indicado' }}\nFecha del evento (UTC): {{ $json.occurredAt }}\nFicha en el CRM: {{ $('Config').first().json.APP_BASE_URL }}/crm/leads/{{ $json.payload.leadId }}\n\nLos datos de contacto del interesado solo se ven en el CRM.",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
