{
  "name": "next-js-template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest",
    "preview": "npm run build:worker && opennextjs-cloudflare preview",
    "deploy": "npm run build:worker && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
    "db:generate": "drizzle-kit generate",
    "build:worker": "opennextjs-cloudflare build && node scripts/strip-env-secrets.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@neon/config": "^1.9.2",
    "@neon/env": "^1.6.3",
    "@neondatabase/auth": "0.6.0-beta",
    "@neondatabase/serverless": "1.2.0",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-table": "^9.2.4",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "0.45.4",
    "lucide-react": "^1.49.0",
    "next": "^16.4.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-qr-code": "2.2.0",
    "server-only": "0.0.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.12",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "^16.4.2",
    "jsdom": "^29.1.1",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3",
    "wrangler": "^4.151.1"
  },
  "overrides": {
    "@better-auth/api-key": "1.7.6",
    "@better-auth/core": "1.7.6"
  }
}
